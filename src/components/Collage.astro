---
import type { Chapter } from '../data/story';
import { story } from '../data/story';
import { photosFor, stampFor } from '../lib/photos';
import ChapterHead from './ChapterHead.astro';
import Polaroid from './Polaroid.astro';
import Keys from './Keys.astro';

interface Props { chapter: Chapter }
const { chapter } = Astro.props;
const photos = photosFor(chapter);
const rots = [-4, 3.5, -2, 5, -3, 2.5];
const speeds = [-0.05, 0.06, -0.02, 0.08, -0.04, 0.05];

let milestone: { months: number; days: number; date: string } | undefined;
if (chapter.milestone) {
  const from = new Date(`${story.official}T12:00:00`);
  const to = new Date(`${chapter.milestone.date}T12:00:00`);
  milestone = {
    months: (to.getFullYear() - from.getFullYear()) * 12 + to.getMonth() - from.getMonth(),
    days: Math.round((to.getTime() - from.getTime()) / 864e5),
    date: to.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }),
  };
}
---
<section class="chapter" id={chapter.id}>
  <ChapterHead chapter={chapter} />
  {milestone && (
    <div class="milestone" data-p>
      <p class="big"><b>{milestone.months}</b> {chapter.milestone!.label}</p>
      <p class="label">{milestone.days} days together · {milestone.date}</p>
    </div>
  )}
  <div class="board" data-gallery data-count={photos.length}>
    {photos.map((p, i) => (
      <Polaroid
        photo={p}
        stamp={stampFor(p, chapter)}
        alt={p.caption ?? `${chapter.month} ${chapter.year}, photo ${i + 1}`}
        rot={rots[i % rots.length]}
        speed={speeds[i % speeds.length]}
      />
    ))}
  </div>
  {(chapter.note || chapter.czech) && (
    <div class="extras">
      {chapter.note && <aside class="note px" style="--rot:1.5deg" data-speed=".03">{chapter.note}</aside>}
      {chapter.czech && <p class="cz">{chapter.czech.text}<small>{chapter.czech.translation}</small></p>}
    </div>
  )}
  {chapter.keys && <Keys {...chapter.keys} />}
</section>

<style>
  .milestone { position: relative; max-width: 980px; margin: -10px auto 40px; text-align: center; }
  .big { font: 700 2.4rem/1 var(--f-hand); color: var(--pen); }
  .big b {
    display: inline-block; font: 400 clamp(6rem, 34vw, 11rem)/0.85 var(--f-disp); color: var(--red); vertical-align: -0.12em;
    scale: calc(0.7 + 0.3 * var(--pe, 1)); transform-origin: 50% 70%;
  }
  .milestone .label { margin-top: 10px; }
</style>
