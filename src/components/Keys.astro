---
// A key ring with a paper tag, swinging a little: the day we moved in together.
// Tapping it gives the keys a good jingle.
interface Props {
  text: string;
  czech?: string;
  date?: string;
}
const { text, czech, date } = Astro.props;
---
<button class="keys" type="button" aria-label={`Keys: ${text}${czech ? `, ${czech}` : ''}`}>
  <span class="swing">
    <svg class="ring" viewBox="0 0 120 150" aria-hidden="true">
      <!-- ring -->
      <circle cx="60" cy="26" r="20" fill="none" stroke="#b8b2a8" stroke-width="5" />
      <!-- brass key -->
      <g transform="rotate(14 60 46)">
        <circle cx="52" cy="62" r="15" fill="#c9a24a" stroke="#9c7a2c" stroke-width="2.5" />
        <circle cx="52" cy="62" r="5" fill="var(--bg)" stroke="#9c7a2c" stroke-width="2" />
        <path d="M52 77 V132 h9 v-7 h-6 v-6 h8 v-7 h-8 V77" fill="#c9a24a" stroke="#9c7a2c" stroke-width="2.5" stroke-linejoin="round" />
      </g>
      <!-- silver key -->
      <g transform="rotate(32 60 46)">
        <rect x="58" y="48" width="24" height="26" rx="8" fill="#d6d3cd" stroke="#8f8a82" stroke-width="2.5" />
        <circle cx="70" cy="56" r="4" fill="var(--bg)" stroke="#8f8a82" stroke-width="2" />
        <path d="M66 74 V128 l5 5 l5 -5 V120 h5 v-6 h-5 v-5 h5 v-6 h-5 V74" fill="#d6d3cd" stroke="#8f8a82" stroke-width="2.5" stroke-linejoin="round" />
      </g>
    </svg>
    <span class="string"></span>
    <span class="tag">
      <span class="tag-text">{text}</span>
      {czech && <span class="tag-cz">{czech}</span>}
      {date && <span class="tag-date">{date}</span>}
    </span>
  </span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('.keys').forEach((k) => {
    k.addEventListener('click', () => {
      k.classList.remove('jingle');
      void k.offsetWidth;
      k.classList.add('jingle');
    });
  });
</script>

<style>
  .keys {
    all: unset; cursor: pointer; display: block; width: 250px; margin: 30px auto -60px; position: relative;
    -webkit-tap-highlight-color: transparent;
  }
  .keys:focus-visible { outline: 3px solid var(--red); outline-offset: 6px; border-radius: 8px; }
  /* hangs from a little nail */
  .keys::before {
    content: ''; position: absolute; left: 60px; top: -6px; width: 10px; height: 10px; translate: -50% 0; border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #9a948b, #5d5851); box-shadow: 0 2px 3px rgba(0, 0, 0, 0.3);
  }
  .swing { display: block; transform-origin: 60px 0; animation: sway 4.5s ease-in-out infinite; }
  .jingle .swing { animation: jingle 1.1s cubic-bezier(0.3, 0.6, 0.3, 1), sway 4.5s 1.1s ease-in-out infinite; }
  @keyframes sway { 0%, 100% { rotate: -3deg; } 50% { rotate: 3deg; } }
  @keyframes jingle {
    0% { rotate: 0deg; } 15% { rotate: 16deg; } 35% { rotate: -12deg; } 55% { rotate: 7deg; } 75% { rotate: -4deg; } 100% { rotate: -3deg; }
  }
  .ring { display: block; width: 120px; filter: drop-shadow(0 8px 6px rgba(40, 25, 15, 0.25)); }
  .tag {
    position: absolute; left: 98px; top: 22px; width: 140px; padding: 12px 12px 10px 22px; rotate: 10deg; transform-origin: 0 50%;
    display: flex; flex-direction: column; gap: 2px;
    background: #f1e6cf; border-radius: 4px 14px 14px 4px;
    clip-path: polygon(14px 0, 100% 0, 100% 100%, 14px 100%, 0 50%);
    box-shadow: 0 6px 10px -4px rgba(40, 25, 15, 0.35);
  }
  /* the eyelet and its string */
  .tag::before {
    content: ''; position: absolute; left: 10px; top: 50%; width: 8px; height: 8px; translate: 0 -50%; border-radius: 50%;
    background: var(--bg); box-shadow: inset 0 0 0 2px #c9b896;
  }
  .string { position: absolute; left: 76px; top: 38px; width: 34px; height: 2px; background: #a99f92; rotate: 22deg; transform-origin: 0 50%; }
  .tag-text { font: 600 1.35rem/1 var(--f-hand); color: var(--pen); white-space: nowrap; }
  .tag-cz { font: 600 1.15rem/1 var(--f-hand); color: var(--red); }
  .tag-date { margin-top: 4px; font: 0.95rem/1 var(--f-stamp); letter-spacing: 0.06em; color: rgba(42, 36, 32, 0.55); }
  @media (prefers-reduced-motion: reduce) { .swing, .jingle .swing { animation: none; } }
</style>
