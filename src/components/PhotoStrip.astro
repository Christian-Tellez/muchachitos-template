---
import type { Chapter } from '../data/story';
import { stampFor, type Photo } from '../lib/photos';
import Polaroid from './Polaroid.astro';

// A row of polaroids you swipe sideways (arrow buttons with a mouse).
// Used by the trip stops and the festival.
interface Props {
  photos: Photo[];
  chapter: Chapter;
  label: string;
  alt: (i: number) => string;
}
const { photos, chapter, label, alt } = Astro.props;
const rots = [-2, 1.75, -1, 2.5];
---
<div class="strip-wrap">
  <div class="strip" data-gallery tabindex="0" aria-label={label}>
    {photos.map((p, i) => (
      <Polaroid
        photo={p}
        stamp={stampFor(p, chapter)}
        alt={p.caption ?? alt(i)}
        rot={rots[i % rots.length]}
        sizes="(min-width: 820px) 280px, 62vw"
      />
    ))}
  </div>
  {photos.length > 1 && (
    <div class="strip-nav">
      <button type="button" class="prev" aria-label="Previous photos">←</button>
      <p class="swipe">swipe →</p>
      <button type="button" class="next" aria-label="Next photos">→</button>
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('.strip-wrap').forEach((wrap) => {
    const strip = wrap.querySelector<HTMLElement>('.strip')!;
    const step = () => (strip.querySelector<HTMLElement>('.pol')?.offsetWidth ?? 280) + 18;
    wrap.querySelector('.prev')?.addEventListener('click', () => strip.scrollBy({ left: -step(), behavior: 'smooth' }));
    wrap.querySelector('.next')?.addEventListener('click', () => strip.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>

<style>
  .strip-wrap { width: 100%; margin-top: 26px; }
  .strip {
    display: flex; gap: 18px; overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: var(--gut); scrollbar-width: none;
    padding: 22px var(--gut) 26px; margin-inline: calc(-1 * var(--gut));
  }
  .strip::-webkit-scrollbar { display: none; }
  .strip:focus-visible { outline: 3px solid var(--red); outline-offset: -3px; }
  .strip :global(.pol) { flex: 0 0 auto; width: min(62vw, 280px); scroll-snap-align: start; }
  .strip :global(.pol:nth-child(even)) { margin-top: 18px; }
  .strip-nav { display: flex; align-items: center; justify-content: center; gap: 14px; }
  .swipe { font: 600 1.25rem/1 var(--f-hand); color: var(--pen); }
  .strip-nav button {
    all: unset; cursor: pointer; display: none; width: 36px; height: 36px; border-radius: 50%; text-align: center; line-height: 36px;
    font: 600 1rem var(--f-ui); color: var(--pen); background: var(--paper); box-shadow: 0 4px 10px -4px rgba(40, 25, 15, 0.4);
  }
  .strip-nav button:focus-visible { outline: 3px solid var(--red); outline-offset: 2px; }
  /* mouse users get arrows instead of the swipe hint */
  @media (hover: hover) and (pointer: fine) {
    .strip-nav button { display: block; }
    .swipe { display: none; }
  }
  @media (min-width: 820px) {
    .strip {
      margin-inline: 0; padding-inline: 24px; scroll-padding-inline: 24px;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent);
      mask-image: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent);
    }
  }

</style>
