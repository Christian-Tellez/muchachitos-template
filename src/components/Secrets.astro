<script>
  // Easter egg: the little pen heart flips its polaroid over; tapping the back flips it again.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  function burst(from: HTMLElement) {
    if (reduced.matches) return;
    const r = from.getBoundingClientRect();
    for (let i = 0; i < 10; i++) {
      const h = document.createElement('span');
      h.className = 'float-heart';
      h.textContent = '♥';
      h.style.left = `${r.left + r.width / 2}px`;
      h.style.top = `${r.top + r.height / 2}px`;
      h.style.setProperty('--dx', `${(Math.random() - 0.5) * 160}px`);
      h.style.setProperty('--dy', `${-90 - Math.random() * 140}px`);
      h.style.setProperty('--s', `${0.7 + Math.random() * 0.9}`);
      h.style.animationDelay = `${i * 40}ms`;
      document.body.append(h);
      h.addEventListener('animationend', () => h.remove());
    }
  }

  document.querySelectorAll<HTMLElement>('.pol.has-secret').forEach((pol) => {
    const heart = pol.querySelector<HTMLButtonElement>('.secret-heart')!;
    const back = pol.querySelector<HTMLButtonElement>('.back')!;
    // move focus to the visible side only for keyboard users (detail 0 = keyboard "click")
    heart.addEventListener('click', (e) => {
      pol.classList.add('flipped');
      burst(heart);
      if (e.detail === 0) back.focus({ preventScroll: true });
    });
    back.addEventListener('click', (e) => {
      pol.classList.remove('flipped');
      if (e.detail === 0) heart.focus({ preventScroll: true });
    });
  });
</script>

<style is:global>
  /* the figure keeps tape, rotation and parallax; the faces carry the paper */
  .pol.has-secret { background: none; padding: 0; box-shadow: none; perspective: 1400px; }
  .flipper { position: relative; display: grid; transition: transform 0.8s cubic-bezier(0.3, 0.7, 0.2, 1); transform-style: preserve-3d; }
  .pol.flipped .flipper { transform: rotateY(180deg); }
  .face {
    grid-area: 1 / 1; position: relative; backface-visibility: hidden; -webkit-backface-visibility: hidden;
    background: var(--paper); padding: 9px 9px 0;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.08), 0 14px 26px -10px rgba(40, 25, 15, 0.5);
  }
  .face.back {
    all: unset; grid-area: 1 / 1; position: relative; box-sizing: border-box; cursor: pointer;
    backface-visibility: hidden; -webkit-backface-visibility: hidden; transform: rotateY(180deg);
    display: flex; flex-direction: column; justify-content: center; gap: 14px; padding: 26px 22px;
    /* the grey-ish back of a real instant photo, with a faint printed pattern */
    background:
      repeating-linear-gradient(45deg, rgba(60, 50, 45, 0.035) 0 2px, transparent 2px 9px),
      #ece7df;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.08), 0 14px 26px -10px rgba(40, 25, 15, 0.5);
  }
  .face.back:focus-visible, .secret-heart:focus-visible { outline: 3px solid var(--red); outline-offset: 3px; }
  .back-text { font: 600 1.45rem/1.25 var(--f-hand); color: var(--blue-ink); text-align: center; text-wrap: balance; white-space: pre-line; }
  .back-hint { font: 600 0.62rem var(--f-ui); letter-spacing: 0.14em; text-transform: uppercase; color: rgba(42, 36, 32, 0.45); text-align: center; }

  /* a doodle more than a button: small, pen-coloured, in the white strip */
  .secret-heart {
    all: unset; cursor: pointer; position: absolute; right: 10px; bottom: 8px; z-index: 4;
    width: 26px; height: 26px; display: grid; place-items: center; -webkit-tap-highlight-color: transparent;
  }
  .secret-heart svg { width: 16px; height: 16px; fill: none; stroke: var(--red); stroke-width: 7; stroke-linecap: round; opacity: 0.75; rotate: -10deg; }
  .secret-heart:hover svg { opacity: 1; scale: 1.15; }
  .pol.flipped .comment { opacity: 0; transition: opacity 0.2s; }

  .float-heart {
    position: fixed; z-index: 70; pointer-events: none; translate: -50% -50%;
    font-size: 1.1rem; color: var(--red);
    animation: float-heart 1.3s cubic-bezier(0.2, 0.6, 0.3, 1) forwards;
  }
  @keyframes float-heart {
    from { opacity: 1; transform: translate(0, 0) scale(var(--s)); }
    to { opacity: 0; transform: translate(var(--dx), var(--dy)) scale(var(--s)) rotate(20deg); }
  }
  @media (prefers-reduced-motion: reduce) { .flipper { transition: none; } }
</style>
