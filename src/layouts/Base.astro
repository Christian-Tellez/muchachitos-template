---
import '../styles/global.css';
import { story } from '../data/story';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const ogImage = new URL('/og.jpg', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {story.private && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#ecd6cf" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Gloock&family=Caveat:wght@500;700&family=VT323&family=Cormorant+Garamond:ital,wght@0,400;1,400;1,500&family=DM+Mono:wght@400;500&family=Hanken+Grotesk:wght@500;600&display=swap"
    />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <slot />
    {import.meta.env.DEV && (
      <div class="dev-switch">
        <span>comments (dev only):</span>
        <button type="button" data-comment-style="arrow">arrow</button>
        <button type="button" data-comment-style="postit">post-it</button>
        <button type="button" data-comment-style="bubble">bubble</button>
        <button type="button" data-comment-style="">as set</button>
        <script is:inline>
          // preview every comment in one style; "as set" goes back to story.ts
          const comments = document.querySelectorAll('.comment');
          comments.forEach((c) => (c.dataset.set = c.dataset.style));
          document.querySelectorAll('[data-comment-style]').forEach((b) =>
            b.addEventListener('click', () =>
              comments.forEach((c) => (c.dataset.style = b.dataset.commentStyle || c.dataset.set)),
            ),
          );
        </script>
      </div>
    )}
  </body>
</html>

<style>
  .dev-switch {
    position: fixed; left: 12px; bottom: calc(12px + env(safe-area-inset-bottom, 0px)); z-index: 60;
    display: flex; align-items: center; gap: 6px; padding: 6px 8px; border-radius: 999px;
    background: rgba(18, 18, 22, 0.85); color: #f4f2ee; font: 600 0.72rem var(--f-ui);
  }
  .dev-switch button { all: unset; cursor: pointer; padding: 6px 10px; border-radius: 999px; background: rgba(255, 255, 255, 0.14); }
</style>
